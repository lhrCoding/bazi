{
  "name": "zhiming",
  "private": true,
  "description": "一元知命（暂名）—— 八字命盘报告网站",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "texts:lint": "tsx scripts/texts-lint.ts",
    "texts:batch": "tsx scripts/texts-batch.ts",
    "texts:coverage": "tsx scripts/texts-coverage.ts",
    "texts:sample": "tsx scripts/texts-sample.ts",
    "texts:preview": "tsx scripts/texts-preview.ts",
    "texts:release": "tsx scripts/texts-release.ts"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "tsx": "4.23.15"
  }
}
